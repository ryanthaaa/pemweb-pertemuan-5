<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container">
  <div class="page-card">
    <h1>Tambah Koleksi Buku</h1>
    <p class="subtitle">Silakan isi formulir berikut untuk memasukkan buku baru ke dalam katalog.</p>

    <form action="/add" method="POST" class="custom-form">
      <div class="form-group">
        <label for="judul">Judul Buku</label>
        <input type="text" id="judul" name="judul" class="form-control" placeholder="Masukkan judul buku lengkap..." required>
      </div>

      <div class="form-group">
        <label for="stok">Jumlah Stok (Eksemplar)</label>
        <input type="number" id="stok" name="stok" class="form-control" min="1" placeholder="Contoh: 10" required>
      </div>

      <div class="form-group">
        <label for="kategori">Kategori Buku</label>
        <select id="kategori" name="kategori" class="form-control" required>
          <option value="" disabled selected>-- Pilih Kategori --</option>
          <option value="Novel">Novel</option>
          <option value="Non-Fiksi">Non-Fiksi</option>
          <option value="Teknologi">Teknologi</option>
          <option value="Sains">Sains</option>
          <option value="Sejarah">Sejarah</option>
        </select>
      </div>

      <button type="submit" class="btn-submit">Simpan ke Katalog</button>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>